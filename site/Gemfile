source "https://rubygems.org"

# Rails, one framework at a time, without the `rails` meta-gem. This site sends
# no mail and accepts no uploads, so Action Mailer, Action Mailbox, Action Text,
# Active Job, and Active Storage aren't installed. config/application.rb
# requires the seven below.
#
# Without Active Storage there's no upload engine in the image to mount by
# accident (see "No uploads" in the README). Active Record is here because
# documents are stored in the gem's Y::Document and Y::DocumentUpdate models
# on SQLite.
rails_version = ["~> 8.1.3", ">= 8.1.3.1"].freeze
gem "actioncable", *rails_version
gem "actionpack", *rails_version
gem "actionview", *rails_version
gem "activemodel", *rails_version
gem "activerecord", *rails_version
gem "activesupport", *rails_version
gem "railties", *rails_version

# Document storage, in one file on a mounted volume. Rails 8's adapter defaults
# (WAL, NORMAL synchronous, busy timeout) suit a single-node deployment, so
# database.yml has no pragma tuning.
gem "sqlite3", ">= 2.1"

# anycable-thruster is Thruster with anycable-go embedded in the proxy. Go
# handles every socket at /cable and calls Rails over HTTP RPC. Behind it,
# Falcon serves the Rack app (the docs pages and the RPC mount) on its fiber
# reactor. `thrust bin/serve` runs the whole stack.
#
# The site uses Falcon for two reasons. Its requests are short and mostly wait
# on IO, which the fiber scheduler handles well. And yrby's CI tests the
# native extension under Falcon: the demo e2e boots under both Puma and
# Falcon, and this site runs the Falcon setup in production.
gem "anycable-thruster"
gem "falcon", ">= 0.55"

# The Rails side of AnyCable: the RPC endpoint mounted in this app, the
# any_cable broadcast adapter, channel state, and whispers.
gem "anycable-rails", "~> 1.6"

# The published gems, so the site runs what a reader installs. yrby-rails
# provides the channel concern and the storage models. The site's documents
# are Y::Document rows, as in the docs.
gem "yrby", "~> 0.8"
gem "yrby-rails", "~> 0.7"

# Collaborative Lexxy editing over yrby. It's require: false because the gem's
# engine requires the lexxy gem, whose engine sets up Action Text helpers in
# to_prepare blocks and can't boot without Action Text. This app doesn't load
# Action Text (see "No uploads" in the README), so config/application.rb
# requires only lexxy_realtime/collaborative. That's the storage concern. It
# checks for has_rich_text and, without it, saves the rendered HTML to a plain
# column. The editor JavaScript comes from npm.
gem "lexxy-realtime", "~> 0.7", require: false

# A lexxy-realtime client uses a signed GlobalID to prove which record and
# field it may join. Rails apps normally get globalid through Active Job,
# which this app doesn't install.
gem "globalid"

# Renders the docs markdown, including GFM tables and fenced code. It's
# published as a precompiled gem.
gem "commonmarker", "~> 2.10"

# Per-IP HTTP throttling. See config/initializers/rack_attack.rb.
gem "rack-attack", "~> 6.7"

gem "tzinfo-data", platforms: %i[windows jruby]

group :development, :test do
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"
end

group :development do
  # Same cops as the gem at the repo root. RuboCop reads that .rubocop.yml for
  # its excludes from either directory, and that file declares these two
  # plugins, so the site needs them too.
  gem "rubocop", require: false
  gem "rubocop-minitest", require: false
  gem "rubocop-rake", require: false
end
