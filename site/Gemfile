source "https://rubygems.org"

# Rails, framework by framework rather than the `rails` meta-gem. This site has
# no mail and — deliberately — no uploads, so Action Mailer, Action Mailbox,
# Action Text, Active Job and Active Storage are not installed at all;
# config/application.rb requires exactly the seven below.
#
# Leaving Active Storage out is the structural half of the no-uploads policy
# (README, "No uploads"): there is no upload engine in the image to mount even
# by accident. Active Record IS here, on purpose: document storage is the
# gem's own Y::Document / Y::DocumentUpdate models on SQLite.
rails_version = ["~> 8.1.3", ">= 8.1.3.1"].freeze
gem "actioncable", *rails_version
gem "actionpack", *rails_version
gem "actionview", *rails_version
gem "activemodel", *rails_version
gem "activerecord", *rails_version
gem "activesupport", *rails_version
gem "railties", *rails_version

# Document storage. One file on a mounted volume; Rails 8's adapter defaults
# (WAL, NORMAL synchronous, busy timeout) are what a single-node deployment
# wants, so database.yml carries no pragma tuning.
gem "sqlite3", ">= 2.1"

# anycable-thruster is Thruster with anycable-go embedded in the proxy: Go
# terminates every socket at /cable and calls back into Rails over HTTP RPC.
# Behind it, Falcon serves the Rack app — the docs pages and the RPC mount —
# on its fiber reactor. `thrust bin/serve` runs the whole stack.
#
# Falcon rather than Puma for two reasons. The requests this app serves are
# short and IO-shaped, which is the fiber scheduler's home ground. And it
# dogfoods the server yrby's own CI proves the native extension under: the
# demo e2e boots both Puma and Falcon deliberately, and this site is the
# Falcon deployment of that pair.
gem "anycable-thruster"
gem "falcon", ">= 0.55"

# The Rails side of AnyCable: the RPC endpoint mounted in this app, the
# any_cable broadcast adapter, channel state, and whispers.
gem "anycable-rails", "~> 1.6"

# Both gems point at this checkout, not RubyGems, only because the site runs
# unreleased API: the shape demos' read panels use Doc#read_array (yrby core)
# and the channels use the fail-closed authorized? seam (yrby-rails). Move
# these back to version requirements once those ship (yrby ~> 0.8,
# yrby-rails ~> 0.7). yrby-rails brings the channel concern AND the storage
# models: the site's documents are Y::Document rows, the exact stack the
# docs teach.
gem "yrby", path: ".."
gem "yrby-rails", path: ".."

# The flagship integration: collaborative Lexxy editing over yrby. require:
# false, deliberately — the gem's engine requires the lexxy gem, whose own
# engine wires Action Text helpers in to_prepare blocks and cannot boot
# without Action Text loaded. This app refuses Action Text (see "No uploads"
# in the README), so config/application.rb requires only
# lexxy_realtime/collaborative: the storage concern, which capability-detects
# has_rich_text and materializes into a plain column without it. The editor
# JavaScript comes from npm, not from the gems' asset builds.
gem "lexxy-realtime", "~> 0.7", require: false

# Signed GlobalIDs are how a lexxy-realtime client proves which record and
# field it may join (the sgid the form flow mints). Rails apps normally get
# this through Active Job, which this app does not carry.
gem "globalid"

# Renders the docs markdown. One gem, ships precompiled, GFM tables and fenced
# code included.
gem "commonmarker", "~> 2.10"

# Per-IP HTTP throttling. See config/initializers/rack_attack.rb.
gem "rack-attack", "~> 6.7"

gem "tzinfo-data", platforms: %i[windows jruby]

group :development, :test do
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"
end

group :development do
  # Same cops as the gem at the repo root. RuboCop reads that .rubocop.yml for
  # its excludes whichever directory it runs from, and that file declares these
  # two plugins, so both have to be here as well.
  gem "rubocop", require: false
  gem "rubocop-minitest", require: false
  gem "rubocop-rake", require: false
end
