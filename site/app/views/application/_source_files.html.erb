<%# The files a page runs, read from disk as it renders (see
    DemoSourceHelper). Locals: paths, and note, a sentence that says where
    anything the files import from comes from, and which parts are left out. %>
<section class="source-files mt-10" aria-labelledby="source-files-heading">
  <h2 id="source-files-heading" class="font-serif text-2xl font-normal tracking-tight text-zinc-100">The source</h2>
  <p class="mt-2 max-w-2xl text-sm leading-6 text-zinc-400">
    This is the code this page runs, read from the server's disk when the
    page renders. <%= note %>
  </p>
  <% paths.each do |path| %>
    <div class="mt-4">
      <%= code_sheet(path) { source_file_block(path) } %>
    </div>
  <% end %>
</section>
