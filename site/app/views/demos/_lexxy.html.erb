<% content_for :head do %>
  <%# Lexxy's editor styles and lexxy-realtime's caret styles, built with the
      page's JS (see frontend/src/lexxy.js). %>
  <link rel="stylesheet" href="<%= busted "/lexxy.css" %>">
<% end %>

<%# The same room as a shared page, where each person can bring an agent. %>
<p class="mb-3 text-sm text-zinc-400">
  <%= link_to "Open this room as a shared page with agents →", demo_space_path(@room), class: "text-accent hover:underline" %>
</p>

<%# Room declares has_collaborative_rich_text :body. The helper renders the
    Lexxy editor inside a <yrby-document> that subscribes to LexxyChannel
    with the room's grant. The site's editor tag has no upload button and no
    upload URLs (app/lib/no_attachments.rb). %>
<%# begin source excerpt %>
<%= form_with model: @room do |form| %>
  <%= form.collaborative_rich_textarea :body %>
<% end %>
<%# end source excerpt %>

<details class="stored group mt-4 rounded-xl border border-zinc-800 bg-panel">
  <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-zinc-400 select-none group-open:border-b group-open:border-zinc-800 hover:text-zinc-200">
    Stored HTML in <code>room.body</code>
  </summary>
  <div class="px-4 py-3">
    <p class="mb-2 text-xs leading-5 text-zinc-500">
      This is the HTML <code>Y::Lexxy</code> saved to <code>room.body</code>,
      the Action Text field your app reads from the record. This panel loads
      it from <code>GET <%= demo_room_body_path(@room) %></code> when you open
      it, and again after each change.
    </p>
    <pre id="stored-html" class="!my-0 max-h-64 text-[0.72rem]" data-url="<%= demo_room_body_path(@room) %>"><code>…</code></pre>
  </div>
</details>
