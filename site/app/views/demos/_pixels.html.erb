<div id="pixels" data-document-key="<%= @document_key %>" data-token="<%= @room_token %>">
  <div id="palette" class="palette" aria-label="palette">
    <% PixelCanvas::PALETTE.each_with_index do |hex, index| %>
      <button type="button" class="swatch" data-index="<%= index %>" data-color="#<%= hex %>"
              style="background: #<%= hex %>" aria-label="color <%= index %>" aria-pressed="false"></button>
    <% end %>
  </div>
  <div class="pixel-stage">
    <canvas id="pixel-canvas" width="<%= PixelCanvas::SIZE %>" height="<%= PixelCanvas::SIZE %>"
            aria-label="pixel canvas"></canvas>
    <div id="pixel-cursors" aria-hidden="true"></div>
  </div>
</div>

<%# The two Ruby renders. Like the stored panel below them, each fetches when
    opened. The PNG stays live while open; the timelapse is a whole replay, so
    it has a Refresh button instead. %>
<details id="png-panel" class="ruby-panel group mt-4 rounded-xl border border-zinc-800 bg-panel">
  <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-zinc-400 select-none group-open:border-b group-open:border-zinc-800 hover:text-zinc-200">
    Rendered in Ruby: <code>PixelCanvas.png(cells)</code>
  </summary>
  <div class="px-4 py-3">
    <p class="mb-3 text-xs leading-5 text-zinc-500">
      Fetched from <code>GET <%= pixel_png_path(@room) %></code> when you open
      this panel, and again after each change while it is open. Ruby reads
      the map with <code>doc.read_map("pixels")</code> and writes the PNG
      itself: a header, a palette chunk, and a zlib stream. No browser and no
      image library. <a href="<%= pixel_png_path(@room) %>" target="_blank" rel="noopener">Open it</a>.
    </p>
    <img id="png" class="pixel-image" data-url="<%= pixel_png_path(@room) %>"
         alt="the canvas, rendered by the server" hidden>
  </div>
</details>

<details id="timelapse-panel" class="ruby-panel group mt-4 rounded-xl border border-zinc-800 bg-panel"
         data-url="<%= pixel_timelapse_path(@room) %>">
  <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-zinc-400 select-none group-open:border-b group-open:border-zinc-800 hover:text-zinc-200">
    Timelapse: replayed from <code>y_document_updates</code>
  </summary>
  <div class="px-4 py-3">
    <p class="mb-3 text-xs leading-5 text-zinc-500">
      Fetched from <code>GET <%= pixel_timelapse_path(@room) %></code> when you
      open this panel. Ruby applies the stored rows to a fresh
      <code>Y::Doc</code> in the order the server recorded them and renders a
      frame along the way, at most <%= PixelCanvas::MAX_FRAMES %>. Nothing
      recorded the history separately; the rows were already there.
    </p>
    <img id="timelapse-frame" class="pixel-image" alt="one frame of the replay" hidden>
    <div class="mt-3 flex items-center gap-3">
      <button id="timelapse-play" type="button"
              class="cursor-pointer rounded-lg border border-zinc-700 px-3 py-1.5 text-xs font-semibold text-zinc-200 hover:border-zinc-500 hover:text-white">Play</button>
      <input id="timelapse-scrub" type="range" min="0" max="0" value="0" aria-label="timelapse position"
             class="flex-1 accent-rose-500">
      <button id="timelapse-refresh" type="button"
              class="cursor-pointer rounded-lg border border-zinc-700 px-3 py-1.5 text-xs font-semibold text-zinc-200 hover:border-zinc-500 hover:text-white">Refresh</button>
    </div>
    <p id="timelapse-caption" class="mt-2 font-mono text-xs text-zinc-500"></p>
  </div>
</details>
