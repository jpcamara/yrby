<% content_for :title, "yrby — real-time collaborative editing for Rails" %>
<% content_for :description, "Real-time collaborative editing for Rails that lives in your database. Documents sync over Action Cable and persist through Active Record, then render back into your model as HTML — no Node process, no third-party service. Rails collaborative editing, Yjs in Rails, collaborative rich text." %>

<% content_for :head do %>
  <%= json_ld_tag(
        "@context" => "https://schema.org",
        "@type" => "SoftwareSourceCode",
        "name" => "yrby",
        "description" => "Real-time collaborative editing for Rails that persists to your database. Live documents sync over Action Cable and render back into the model as HTML — no Node process, no third-party service.",
        "url" => canonical_host,
        "codeRepository" => "https://github.com/jpcamara/yrby",
        "programmingLanguage" => ["Ruby", "JavaScript"],
        "runtimePlatform" => "Ruby on Rails",
        "license" => "https://opensource.org/licenses/MIT",
        "author" => {
          "@type" => "Person",
          "name" => "JP Camara",
          "url" => "https://jpcamara.com",
          "sameAs" => "https://github.com/jpcamara"
        }
      ) %>
<% end %>

<%# ---- Hero ------------------------------------------------------------- %>
<section class="grid gap-12 pt-6 pb-16 sm:pt-14 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
  <div>
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-zinc-100 sm:text-5xl">
      Collaborative editing that lives in your database.
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-400">
      Live documents sync over Action Cable and persist through Active Record.
      After every change the server renders the document back into
      <code>post.body</code> as plain HTML, so search, mailers, and everything
      downstream keep working. No Node process. No third-party service.
    </p>

    <div class="mt-8 space-y-2">
      <%= sample_lexxy_model %>
      <%= sample_lexxy_form %>
    </div>

    <p class="mt-5 font-mono text-sm text-zinc-500">
      <span class="text-accent">bundle add lexxy-realtime</span>
      &nbsp;·&nbsp;
      <span class="text-accent">bin/rails g lexxy_realtime:install</span>
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <%= link_to "Read the docs", doc_path("getting-started"),
                  class: "rounded-lg bg-accent-strong px-4 py-2 text-sm font-semibold text-white hover:bg-rose-500" %>
      <a class="rounded-lg border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200 hover:border-zinc-500 hover:text-white"
         href="https://github.com/jpcamara/yrby">GitHub</a>
    </div>
  </div>

  <%# The live hero (two synced editor panes) is phase 2 — it needs the demo
      backend wired in. This is a still; the live version is one click away on
      the demos page. %>
  <aside class="rounded-2xl border border-zinc-800 bg-panel p-4">
    <div class="grid grid-cols-2 gap-3">
      <% [["you", "text-accent"], ["Ada", "peer-caret"]].each do |name, color| %>
        <div class="rounded-lg border border-zinc-800 bg-zinc-950 p-3 text-sm leading-relaxed text-zinc-300">
          <span class="text-xs font-semibold tracking-widest <%= color %> uppercase"><%= name %></span>
          <p class="mt-2">Ship it together<span class="caret <%= color %>" aria-hidden="true">▌</span></p>
        </div>
      <% end %>
    </div>
    <p class="mt-3 text-xs leading-5 text-zinc-500">
      A still. The live version is on the
      <%= link_to "demos", demo_path("lexxy"), rel: "nofollow", class: "text-accent hover:underline" %> —
      type in either pane and both sync through one Action Cable channel.
    </p>
  </aside>
</section>

<%# ---- Three lines, if you use Lexxy ----------------------------------- %>
<section id="lexxy" class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    Three lines, if you use Lexxy.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    Lexxy is Basecamp's rich text editor for Rails — the successor to the
    Action Text editor. lexxy-realtime makes it collaborative: a model macro, a
    form helper, and a generator that creates the sync channel and the document
    tables.
  </p>

  <div class="mt-6 max-w-2xl space-y-4">
    <div>
      <p class="mb-1 font-mono text-xs text-zinc-500">app/models/post.rb</p>
      <%= sample_lexxy_model %>
    </div>
    <div>
      <p class="mb-1 font-mono text-xs text-zinc-500">app/views/posts/_form.html.erb</p>
      <%= sample_lexxy_form %>
    </div>
    <div>
      <p class="mb-1 font-mono text-xs text-zinc-500">terminal</p>
      <%= sample_lexxy_install %>
    </div>
  </div>

  <p class="mt-4 max-w-2xl leading-7 text-zinc-400">
    Implement <code>authorized?</code> in the generated channel — everyone is
    denied until you do. Then open the form in two browsers and type.
  </p>
  <p class="mt-4">
    <%= link_to "lexxy-realtime quick start →", doc_path("getting-started"),
                class: "text-accent underline decoration-rose-400/40 underline-offset-2 hover:decoration-rose-400" %>
  </p>
</section>

<%# ---- post.body stays a normal attribute ------------------------------ %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    <code class="text-2xl">post.body</code> stays a normal attribute.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    After each change, the channel renders the collaborative document to HTML on
    the server and saves it through the standard Action Text writer. The markup
    is byte-identical to what the editor itself would submit — CI checks it
    byte-for-byte against documents captured from a real editor. Search indexes
    it. Mailers render it. Anything that reads <code>post.body</code> reads the
    current document.
  </p>
  <div class="mt-6 max-w-2xl">
    <%= code_block "ruby", <<~RUBY %>
      doc = Y::Doc.new
      doc.apply_update(Y::Document.load_state(key))

      Y::Lexxy.new(doc).to_html  # byte-identical to the editor's serializer
    RUBY
  </div>
  <p class="mt-4 max-w-2xl leading-7 text-zinc-400">
    The renderers know the full Lexxy and Tiptap node sets, take rules for your
    app's custom nodes, and run in Ruby. No headless browser anywhere.
  </p>
  <p class="mt-4">
    <%= link_to "See it land in the database, live →", demo_path("lexxy"), rel: "nofollow",
                class: "text-accent underline decoration-rose-400/40 underline-offset-2 hover:decoration-rose-400" %>
  </p>
</section>

<%# ---- The whole server side is one channel ---------------------------- %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    The whole server side is one channel.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    No separate sync server. <code>Y::ActionCable</code> implements the full
    y-websocket protocol — document sync and presence — as a channel concern.
    You answer two hooks: load state, record a change. Storage is whatever the
    hooks point at.
  </p>
  <div class="mt-6 max-w-2xl">
    <%= code_block "ruby", <<~RUBY %>
      class DocumentChannel < ApplicationCable::Channel
        include Y::ActionCable

        on_load   { |key|         Y::Document.load_state(key) }
        on_change { |key, update| Y::Document.append(key, update) }

        def subscribed    = sync_subscribed(params[:id])
        def receive(data) = sync_receive(data, params[:id])
      end
    RUBY
  </div>
</section>

<%# ---- Nothing new to deploy ------------------------------------------- %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    Nothing new to deploy.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    A Node sync server is a second runtime to deploy, monitor, scale, and
    authenticate against. A hosted service puts your documents on someone else's
    servers, priced per user. yrby is a gem. The sync server is your Rails app,
    the store is your database, and auth is your channel's
    <code>authorized?</code>.
  </p>
  <div class="mt-6 overflow-x-auto">
    <table class="compare min-w-full text-sm">
      <thead>
        <tr>
          <th>Node sidecar</th>
          <th>Hosted service</th>
          <th class="accent-col">yrby</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>y-websocket or Hocuspocus next to Rails</td>
          <td>Liveblocks and similar</td>
          <td class="accent-col"><code>gem "yrby-rails"</code></td>
        </tr>
        <tr>
          <td>Second runtime, own persistence, auth bridged over tokens</td>
          <td>Documents live off-site, per-MAU pricing, another vendor in the request path</td>
          <td class="accent-col">One channel, your Postgres, your <code>authorized?</code></td>
        </tr>
        <tr>
          <td>HTML out means a headless editor</td>
          <td>HTML out means their API</td>
          <td class="accent-col">HTML out means <code>Y::Lexxy.new(doc).to_html</code></td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="mt-4 max-w-2xl text-sm leading-6 text-zinc-500">
    Precompiled gems for Ruby 3.4 and 4.0 on the supported platforms. No Rust
    toolchain to install.
  </p>
</section>

<%# ---- Acked means stored ---------------------------------------------- %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    Acked means stored.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    The client resends every update until the server acknowledges it, and the
    server acknowledges only after your store has recorded it. Record before
    distribute: if the write fails, nobody sees the change and the client
    retries. Updates that arrive out of order park as pending and heal when the
    missing piece lands. Replaying the log always rebuilds the document — one
    process or many, Puma or AnyCable.
  </p>
  <pre class="wire mt-6 max-w-2xl">browser ── update #42 ──▶ channel ── on_change ──▶ your store
browser ◀── ack 42 ──────┘              (recorded first, then broadcast)</pre>
  <p class="mt-4">
    <%= link_to "Delivery guarantees →", doc_path("javascript-client"),
                class: "text-accent underline decoration-rose-400/40 underline-offset-2 hover:decoration-rose-400" %>
  </p>
</section>

<%# ---- Bring your editor ----------------------------------------------- %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    Bring your editor.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    yrby syncs opaque Yjs updates, so any editor with a Yjs binding works. CI
    drives four in real Chrome: Tiptap, Lexxy, Rhino Editor, and CodeMirror —
    concurrent typing, remote cursors, undo, and byte parity between the server
    renderer and the editor's own serializer. No editor also works: a whiteboard
    on a <code>Y.Map</code>, a kanban board on a <code>Y.Array</code>, a form
    your team fills in together.
  </p>
  <ul class="demo-list">
    <% Demos::ALL.each do |demo| %>
      <li>
        <%= link_to demo.title, demo_path(demo.slug), rel: "nofollow" %>
        <code><%= demo.shape %></code>
        <span><%= demo.blurb %></span>
      </li>
    <% end %>
  </ul>
  <p class="mt-2">
    <%= link_to "See the demos →", demos_path,
                class: "text-accent underline decoration-rose-400/40 underline-offset-2 hover:decoration-rose-400" %>
  </p>
</section>

<%# ---- Built for the deployment you already have ----------------------- %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    Built for the deployment you already have.
  </h2>
  <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <% [
      ["Thread-safe.", "A <code>Doc</code> is shared across Puma and Action Cable threads with no external locking."],
      ["Parallel on MRI.", "CRDT work runs with the GVL released; a measured 2x wall-clock speedup applying large updates concurrently."],
      ["Hostile input handled.", "Every frame is validated before anything processes it. A bad frame is dropped; a native panic becomes a Ruby exception, not a crashed process."],
      ["Multi-process.", "Record-before-distribute holds across processes; any worker can serve any document from the shared store."],
      ["AnyCable.", "The same channel concern, tested end to end against a real anycable-go gateway. In an authenticated app, presence can ride AnyCable whispers and skip Ruby entirely."],
      ["Encrypted at rest.", "<code>Y::EncryptedDocument</code> stores state and updates through Active Record encryption, the way <code>ActionText::EncryptedRichText</code> does."]
    ].each do |title, body| %>
      <div class="rounded-xl border border-zinc-800 bg-panel p-4">
        <h3 class="text-sm font-semibold text-zinc-100"><%= title %></h3>
        <p class="mt-1.5 text-sm leading-6 text-zinc-400 [&_code]:text-zinc-300"><%= body.html_safe %></p>
      </div>
    <% end %>
  </div>
</section>

