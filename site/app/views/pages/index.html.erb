<% content_for :title, "yrby: real-time collaborative editing for Rails" %>
<% content_for :description, "Real-time collaborative editing for Rails. Documents sync over Action Cable, are stored in your database through Active Record, and render back to HTML in Ruby. There is no Node process to run and no third-party service." %>

<% content_for :head do %>
  <%= json_ld_tag(
        "@context" => "https://schema.org",
        "@type" => "SoftwareSourceCode",
        "name" => "yrby",
        "description" => "Real-time collaborative editing for Rails. Documents sync over Action Cable, persist to your database, and render back to HTML in Ruby, with no Node process and no third-party service.",
        "url" => canonical_host,
        "codeRepository" => "https://github.com/jpcamara/yrby",
        "programmingLanguage" => ["Ruby", "JavaScript"],
        "runtimePlatform" => "Ruby on Rails",
        "license" => "https://opensource.org/licenses/MIT",
        "author" => {
          "@type" => "Person",
          "name" => "JP Camara",
          "url" => "https://jpcamara.com",
          "sameAs" => "https://github.com/jpcamara"
        }
      ) %>
<% end %>

<%# ---- Hero ------------------------------------------------------------- %>
<%# minmax(0,...) on BOTH layouts: a grid item's min-width:auto would otherwise
    let the hero code block's intrinsic width push the page wider than a phone
    viewport (the pre then scrolls internally instead). %>
<section class="grid grid-cols-[minmax(0,1fr)] gap-12 pt-6 pb-16 sm:pt-14 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
  <div>
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-zinc-100 sm:text-5xl">
      Collaborative editing that runs in Ruby and Rails.
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-400">
      Documents sync over Action Cable and are stored in your own database
      through Active Record. You add one view helper. There is no Node
      process to run and no third-party service holding your data. Your
      Rails app is the sync server.
    </p>

    <div class="mt-8 max-w-2xl space-y-4">
      <div>
        <p class="mb-1 font-mono text-xs text-zinc-500">app/views/posts/edit.html.erb</p>
        <%= hero_tag_line %>
      </div>
      <div>
        <p class="mb-1 font-mono text-xs text-zinc-500">the same document, read back in Ruby</p>
        <%= hero_read_back_code %>
      </div>
    </div>

    <p class="mt-4 max-w-2xl text-sm leading-6 text-zinc-500">
      The tag renders a signed grant for that record and attribute, the same
      way <code>turbo_stream_from</code> signs its stream names. The
      gem's channel verifies the grant and records each change before it
      acknowledges it. You don't write a channel, and the page decides
      which document the client gets.
    </p>

    <p class="mt-5 font-mono text-sm text-zinc-500">
      <span class="text-accent">gem "yrby-rails"</span>
      &nbsp;·&nbsp;
      <span class="text-accent">bin/rails yrby:install</span>
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <%= link_to "Read the docs", doc_path("getting-started"),
                  class: "rounded-lg bg-accent-strong px-4 py-2 text-sm font-semibold text-white hover:bg-rose-500" %>
      <a class="rounded-lg border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200 hover:border-zinc-500 hover:text-white"
         href="https://github.com/jpcamara/yrby">GitHub</a>
    </div>
  </div>

  <%# The live hero (two synced editor panes) is phase 2: it needs the demo
      backend wired in. This is a still; the live version is one click away on
      the demos page. %>
  <aside class="rounded-2xl border border-zinc-800 bg-panel p-4">
    <div class="grid grid-cols-2 gap-3">
      <% [["you", "text-accent"], ["Ada", "peer-caret"]].each do |name, color| %>
        <div class="rounded-lg border border-zinc-800 bg-zinc-950 p-3 text-sm leading-relaxed text-zinc-300">
          <span class="text-xs font-semibold tracking-widest <%= color %> uppercase"><%= name %></span>
          <p class="mt-2">Ship it together<span class="caret <%= color %>" aria-hidden="true">▌</span></p>
        </div>
      <% end %>
    </div>
    <p class="mt-3 text-xs leading-5 text-zinc-500">
      This one is a still. The live version is on the
      <%= link_to "demos", demo_path("lexxy"), rel: "nofollow", class: "text-accent hover:underline" %> page.
      Type in either pane and both sync through one Action Cable channel.
    </p>
  </aside>
</section>

<%# ---- Read it back in Ruby ---------------------------------------------- %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    Read the document back, in Ruby.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    Ruby can read a stored document directly. A <code>Y.Text</code> comes back
    as plain text, and <code>Y.Map</code> and <code>Y.Array</code> roots
    come back as JSON. For rich text there are dedicated renderers:
    <code>Y::Lexxy</code> and <code>Y::Tiptap</code> produce the same HTML
    the editor itself would save, byte for byte, and CI checks that
    against documents captured from real editors. Both take rules for your
    app's custom nodes.
  </p>
  <div class="mt-6 max-w-2xl">
    <%= code_block "ruby", <<~RUBY %>
      doc = Y::Doc.new
      doc.apply_update(Y::Document.load_state(key))

      doc.read_text("code")      # Y.Text -> plain text
      doc.read_array("cards")    # Y.Array -> JSON (read_map for Y.Map roots)
      Y::Lexxy.new(doc).to_html  # rich text, byte-identical to the editor
    RUBY
  </div>
  <p class="mt-4 max-w-2xl leading-7 text-zinc-400">
    Write that HTML into a normal column and the rest of your app can treat it
    like any other attribute. Search indexes it, mailers render it,
    read-only views show it. lexxy-realtime does this for you, updating
    the column after every change.
  </p>
  <p class="mt-4">
    <%= link_to "Every demo shows its server-side read, live →", demos_path,
                class: "text-accent underline decoration-rose-400/40 underline-offset-2 hover:decoration-rose-400" %>
  </p>
</section>

<%# ---- The whole server side is one channel ---------------------------- %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    The server side is one channel.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    The tag at the top of this page is the entire integration. There is no
    separate sync server. <code>Y::ActionCable</code> implements the
    y-websocket protocol, document sync and presence, as a channel
    concern. If you want control over storage, you answer two hooks: one
    loads state and one records a change. They can point at anything.
  </p>
</section>

<%# ---- Nothing new to deploy ------------------------------------------- %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    Nothing new to deploy.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    A Node sync server is a second runtime you have to deploy, monitor, scale,
    and authenticate against. A hosted service puts your documents on
    someone else's servers and charges per user. yrby is a gem. Your Rails
    app is the sync server, your database is the store, and the signed
    grant your page renders is the auth.
  </p>
  <div class="mt-6 overflow-x-auto">
    <table class="compare min-w-full text-sm">
      <thead>
        <tr>
          <th>Node sidecar</th>
          <th>Hosted service</th>
          <th class="accent-col">yrby</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>y-websocket or Hocuspocus next to Rails</td>
          <td>Liveblocks and similar</td>
          <td class="accent-col"><code>gem "yrby-rails"</code></td>
        </tr>
        <tr>
          <td>Second runtime, own persistence, auth bridged over tokens</td>
          <td>Documents live off-site, per-MAU pricing, another vendor in the request path</td>
          <td class="accent-col">One gem, your Postgres, your page's signed grant</td>
        </tr>
        <tr>
          <td>HTML out means a headless editor</td>
          <td>HTML out means their API</td>
          <td class="accent-col">HTML out means <code>Y::Lexxy.new(doc).to_html</code></td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="mt-4 max-w-2xl text-sm leading-6 text-zinc-500">
    Precompiled gems ship for Ruby 3.4 and 4.0 on the supported platforms, so
    you don't need a Rust toolchain.
  </p>
</section>

<%# ---- Acked means stored ---------------------------------------------- %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    The ack comes after the write.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    The client resends each update until the server acknowledges it, and the
    server only acknowledges after your store has recorded it. If the
    write fails, nobody sees the change and the client tries again. An
    update that arrives out of order waits as pending until the update it
    depends on shows up. Replaying the log rebuilds the document, whether
    you run one process or many, on Puma or AnyCable.
  </p>
  <pre class="wire mt-6 max-w-2xl">browser ── update #42 ──▶ channel ── on_change ──▶ your store
browser ◀── ack 42 ──────┘              (recorded first, then broadcast)</pre>
  <p class="mt-4">
    <%= link_to "Delivery guarantees →", doc_path("javascript-client"),
                class: "text-accent underline decoration-rose-400/40 underline-offset-2 hover:decoration-rose-400" %>
  </p>
</section>

<%# ---- Three lines, if you use Lexxy ----------------------------------- %>
<section id="lexxy" class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    Three lines, if you use Lexxy.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    Lexxy is Basecamp's rich text editor for Rails, the successor to the
    Action Text editor. lexxy-realtime makes it collaborative with a model
    macro, a form helper, and a generator that creates the sync channel
    and the document tables.
  </p>

  <div class="mt-6 max-w-2xl space-y-4">
    <div>
      <p class="mb-1 font-mono text-xs text-zinc-500">app/models/post.rb</p>
      <%= sample_lexxy_model %>
    </div>
    <div>
      <p class="mb-1 font-mono text-xs text-zinc-500">app/views/posts/_form.html.erb</p>
      <%= sample_lexxy_form %>
    </div>
    <div>
      <p class="mb-1 font-mono text-xs text-zinc-500">terminal</p>
      <%= sample_lexxy_install %>
    </div>
  </div>

  <p class="mt-4 max-w-2xl leading-7 text-zinc-400">
    Implement <code>authorized?</code> in the channel the generator wrote.
    Until you do, every subscriber is denied. Then open the form in two
    browsers and type.
  </p>
  <p class="mt-4">
    <%= link_to "More on Lexxy →", "/lexxy",
                class: "text-accent underline decoration-rose-400/40 underline-offset-2 hover:decoration-rose-400" %>
  </p>
</section>

<%# ---- Bring your editor ----------------------------------------------- %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    Bring your editor.
  </h2>
  <p class="mt-3 max-w-2xl leading-7 text-zinc-400">
    yrby syncs Yjs updates without looking inside them, so any editor with a
    Yjs binding works. CI drives four of them in real Chrome (Tiptap,
    Lexxy, Rhino Editor, and CodeMirror) and checks concurrent typing,
    remote cursors, undo, and that the server renderer matches the
    editor's own serializer byte for byte. You don't need an editor at
    all: a whiteboard on a <code>Y.Map</code>, a kanban board on a
    <code>Y.Array</code>, or a form your team fills in together all sync
    the same way.
  </p>
  <ul class="demo-list">
    <% Demos::ALL.each do |demo| %>
      <li>
        <%= link_to demo.title, demo_path(demo.slug), rel: "nofollow" %>
        <code><%= demo.shape %></code>
        <span><%= demo.blurb %></span>
      </li>
    <% end %>
  </ul>
  <p class="mt-2">
    <%= link_to "See the demos →", demos_path,
                class: "text-accent underline decoration-rose-400/40 underline-offset-2 hover:decoration-rose-400" %>
  </p>
</section>

<%# ---- Built for the deployment you already have ----------------------- %>
<section class="border-t border-zinc-800/70 py-14">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-100">
    Built for the deployment you already have.
  </h2>
  <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <% [
      ["Thread-safe.", "A <code>Doc</code> can be shared across Puma and Action Cable threads without any locking on your side."],
      ["Parallel on MRI.", "CRDT work runs with the GVL released. Applying large updates concurrently measured a 2x wall-clock speedup."],
      ["Hostile input handled.", "Every frame is validated before anything processes it. A bad frame is dropped, and a native panic is raised as a Ruby exception instead of taking the process down."],
      ["Multi-process.", "Changes are recorded before they are broadcast, across processes too. Any worker can serve any document from the shared store."],
      ["AnyCable.", "The same channel concern, tested end to end against a real anycable-go gateway. In an authenticated app, presence can travel over AnyCable whispers and skip your Ruby process."],
      ["Encrypted at rest.", "<code>Y::EncryptedDocument</code> stores state and updates through Active Record encryption, the way <code>ActionText::EncryptedRichText</code> does."]
    ].each do |title, body| %>
      <div class="rounded-xl border border-zinc-800 bg-panel p-4">
        <h3 class="text-sm font-semibold text-zinc-100"><%= title %></h3>
        <p class="mt-1.5 text-sm leading-6 text-zinc-400 [&_code]:text-zinc-300"><%= body.html_safe %></p>
      </div>
    <% end %>
  </div>
</section>

