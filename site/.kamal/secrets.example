# Kamal reads secrets from .kamal/secrets. This file is the committed template,
# and the real one is gitignored. Copy it and fill in real values. Better yet,
# have each line pull from your password manager or CI secret store, so the
# secrets never get written to disk:
#
#   cp .kamal/secrets.example .kamal/secrets
#
# Kamal also supports command substitution here, e.g.
#   SECRET_KEY_BASE=$(op read op://vault/yrby-site/secret_key_base)
# so the file holds references to the secrets and not the secrets themselves.

# Rails session/signing key. Generate once, keep stable:
#   openssl rand -hex 64
SECRET_KEY_BASE=

# The embedded anycable-go and Rails both derive the HTTP RPC key and the
# broadcast key from this, so one variable keeps them in agreement. Generate
# once, keep stable:
#   openssl rand -hex 32
ANYCABLE_SECRET=

# Registry password for `kamal deploy` (the image push). Only needed if your
# registry is private.
KAMAL_REGISTRY_PASSWORD=
