# Kamal reads secrets from .kamal/secrets (this file is the committed template;
# the real one is gitignored). Copy it and fill in real values, or better, have
# each line pull from your password manager / CI secret store so nothing
# sensitive ever lands on disk:
#
#   cp .kamal/secrets.example .kamal/secrets
#
# Kamal also supports command substitution here, e.g.
#   SECRET_KEY_BASE=$(op read op://vault/yrby-site/secret_key_base)
# so the file can hold references rather than the secrets themselves.

# Rails session/signing key. Generate once, keep stable:
#   openssl rand -hex 64
SECRET_KEY_BASE=

# Configures both halves of AnyCable at once — the embedded anycable-go and
# Rails each derive the HTTP RPC key and the broadcast key from it, so the two
# agree without a second variable. Generate once, keep stable:
#   openssl rand -hex 32
ANYCABLE_SECRET=

# Registry password for `kamal deploy` (the image push). Only needed if your
# registry is private.
KAMAL_REGISTRY_PASSWORD=
