#!/usr/bin/env bash
# Starts Falcon, the Rails server behind thrust.
#
# thrust runs this command. Before it does, thrust sets PORT to its TARGET_PORT
# (thruster's internal/service.go calls os.Setenv("PORT", ...)). That's all the
# proxy tells its upstream. Puma reads PORT on its own, but Falcon takes a
# --bind URL, so this script converts it.
#
# Falcon runs four worker processes, so RPC calls use more than one core.
# Documents, rooms, and seats live in the database, so any worker can serve
# any command. The rest of the throttle accounting is per process: the size
# cache, ConnectionGuard buckets, WriteBudget, and Rack::Attack counters.
# With N workers each one enforces its own copy, so those caps can get up to
# N times looser. FALCON_COUNT sets the number of workers, and FALCON_THREADS
# with it switches to Falcon's hybrid container (forks x threads). See
# "Several processes" in site/README.md.
set -euo pipefail

COUNT="${FALCON_COUNT:-${WEB_CONCURRENCY:-4}}"
THREADS="${FALCON_THREADS:-0}"

# Plain http, because Falcon defaults to https with a self-signed cert. Bind to
# loopback only. thrust and the embedded anycable-go are the only clients, and
# both connect over localhost. Binding all interfaces would expose Falcon
# directly, skipping the proxy's MAX_REQUEST_BODY and making the RPC mount
# reachable from the network.
if [ "$THREADS" != "0" ]; then
  bundle exec falcon serve --bind "http://127.0.0.1:${PORT:-3000}" \
    --hybrid --forks "$COUNT" --threads "$THREADS" &
else
  bundle exec falcon serve --bind "http://127.0.0.1:${PORT:-3000}" --count "$COUNT" &
fi
web=$!

# Solid Queue, which runs the demo agents, in processes of its own beside
# Falcon: a supervisor that forks JOB_PROCESSES workers (config/queue.yml).
# A signal from thrust stops both, and either one exiting stops the other,
# so thrust sees the stack go down together.
bin/jobs &
jobs=$!

trap 'kill -TERM "$web" "$jobs" 2>/dev/null' TERM INT
while kill -0 "$web" 2>/dev/null && kill -0 "$jobs" 2>/dev/null; do
  sleep 1
done
kill -TERM "$web" "$jobs" 2>/dev/null || true
wait
