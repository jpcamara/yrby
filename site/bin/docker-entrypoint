#!/usr/bin/env bash
# Prepare the SQLite database on the mounted volume, then run CMD.
# db:prepare creates the file and runs migrations on first boot, and runs any
# new migrations after that, so deploys and restarts need no manual step.
set -euo pipefail

# Allowed WebSocket origins for both halves of the cable, from one value.
# Rails reads ALLOWED_ORIGINS itself. The embedded anycable-go wants only
# host[:port], so strip the scheme. This happens at runtime because each
# deploy sets its own origins. If ALLOWED_ORIGINS is unset, any origin is
# allowed.
if [ -n "${ALLOWED_ORIGINS:-}" ] && [ -z "${ANYCABLE_ALLOWED_ORIGINS:-}" ]; then
  ANYCABLE_ALLOWED_ORIGINS="$(printf '%s' "$ALLOWED_ORIGINS" | sed 's#https\{0,1\}://##g')"
  export ANYCABLE_ALLOWED_ORIGINS
fi

if [[ "$*" == *"thrust"* ]]; then
  ./bin/rails db:prepare
fi

exec "$@"
