{
  "name": "yrby-site-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.mjs && bun run build:css",
    "watch": "bun build.mjs --watch",
    "lint": "eslint .",
    "build:css": "tailwindcss -i css/site.css -o ../public/site.css --minify",
    "watch:css": "tailwindcss -i css/site.css -o ../public/site.css --watch"
  },
  "dependencies": {
    "@anycable/web": "^1.1.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.26.0",
    "@tanstack/table-core": "^9.2.4",
    "@tiptap/core": "^2.11.0",
    "@tiptap/extension-collaboration": "^2.11.0",
    "@tiptap/extension-collaboration-cursor": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "codemirror": "^6.0.1",
    "lib0": "^0.2.117",
    "y-codemirror.next": "^0.3.5",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20",
    "yrby-client": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.1",
    "agent-browser": "^0.28.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "tailwindcss": "^4.1"
  }
}
