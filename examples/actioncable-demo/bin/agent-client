#!/usr/bin/env ruby
# frozen_string_literal: true

# A ReviewAgent in a process of its own, joined to a running demo over the
# cable's websocket the way a browser joins. The server records, acks, and
# distributes what it writes; this process touches neither the store nor
# the pubsub, so it can run anywhere that reaches the cable.
#
#   bin/agent-client demo                                # the document /docs/demo/lexxy shows
#   CABLE_URL=ws://127.0.0.1:9600/cable bin/agent-client demo
#
# The agent and the client's socket share one Async reactor: the agent's
# waits (sleep, Queue#pop with a timeout, the model call) yield to it.
require_relative "../config/environment"
require "y/action_cable/client"

document_id = ARGV.fetch(0, "demo")
url = ENV.fetch("CABLE_URL", "ws://127.0.0.1:3000/cable")
$stdout.sync = true
Rails.logger.broadcast_to(ActiveSupport::Logger.new($stdout)) if Rails.logger.respond_to?(:broadcast_to)

client = Y::ActionCable::Client.new(url, channel: "DocumentChannel", params: { id: document_id }, logger: Rails.logger)
Sync { ReviewAgent.new(document_id, peer: client).run }
