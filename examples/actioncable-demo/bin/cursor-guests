#!/usr/bin/env ruby
# frozen_string_literal: true

# The eight guests in a process of their own, joined to a running demo over
# the cable's websocket the way browsers join. The server records and
# distributes their presence; this process touches neither the store nor
# the pubsub, so it can run anywhere that reaches the cable.
#
#   bin/cursor-guests demo                             # the document /docs/demo/cursors shows
#   bin/cursor-guests demo ws://127.0.0.1:9600/cable
#
# Needs TYPESAFE_API_KEY in the environment. The guests and their sockets
# share one Async reactor; each guest's mind runs in a thread of its own.
require_relative "../config/environment"

document_id = "#{ARGV.fetch(0, "demo")}:cursors"
url = ARGV.fetch(1) { ENV.fetch("CABLE_URL", "ws://127.0.0.1:3000/cable") }
abort "cursor-guests: set TYPESAFE_API_KEY" unless GuestParty.available?
$stdout.sync = true
Rails.logger.broadcast_to(ActiveSupport::Logger.new($stdout)) if Rails.logger.respond_to?(:broadcast_to)

Sync { GuestParty.new(document_id, url: url, logger: Rails.logger).run }
