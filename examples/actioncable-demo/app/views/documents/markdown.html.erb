<div class="demo">
  <header>
    <h1>yrby collaborative editor <small>(Markdown)</small></h1>
    <%= render "nav" %>
    <p>
      Document <code><%= @document_id %></code> —
      open this page in another window to edit together. The document is a
      <code>Y.Text</code> of markdown bound with <code>y-codemirror.next</code>;
      the preview renders the same text. The agent works on it as markdown.
    </p>
    <p id="status" class="status">connecting…</p>
  </header>

  <div id="agent-bar" class="agent-bar">
    <span class="bar-dot"></span>
    <span class="bar-status">no agent here yet</span>
    <span class="bar-detail"></span>
    <a href="#" id="jump-to-agent">jump to it</a>
    <label><input type="checkbox" id="agent-follow" checked> follow</label>
  </div>
  <div class="agent-actions">
    <button type="button" data-say="@agent ">Ask it something</button>
    <button type="button" data-say="@agent take ">Hand it a task</button>
    <button type="button" data-say="@agent draft this section">Draft this section</button>
    <button type="button" data-say="@agent rewrite this ">Rewrite what I selected</button>
    <button type="button" data-say="@agent undo">Undo its last change</button>
    <button type="button" data-say="@agent pause">Pause</button>
    <button type="button" data-say="@agent resume">Resume</button>
  </div>
  <p class="agent-hint">Talk to it on a line of its own: <code>@agent</code> and a question, <code>@agent take</code> and a task, or select some text and write <code>@agent rewrite this</code> under it. Tasks under a heading named <b>For the agent</b> get picked up on their own.</p>
  <div class="markdown-pane">
    <div id="editor" data-document-id="<%= @document_id %>:markdown"></div>
    <div id="preview" class="markdown-preview" aria-label="Rendered markdown"></div>
  </div>
  <ol id="agent-log" class="agent-log" aria-label="What the agent is doing"></ol>

<%= button_to "Invite the agent", document_markdown_agent_path(params[:id]), class: "invite-agent", form: { style: "display:inline" } %>
  <div id="presence-roster" class="presence-roster" aria-label="Who is here"></div>
</div>

<style>
  .markdown-pane { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 1rem; align-items: start; }
  @media (max-width: 900px) { .markdown-pane { grid-template-columns: minmax(0, 1fr); } }
  .markdown-preview { border: 1px solid #e5e7eb; border-radius: 8px; padding: 1rem 1.25rem; background: #fafafa; min-height: 24rem; max-height: 70vh; overflow: auto; font-size: 15px; line-height: 1.6; }
  .markdown-preview h1 { font-size: 1.5em; margin: .2em 0 .5em; } .markdown-preview h2 { font-size: 1.25em; margin: 1em 0 .4em; }
  .markdown-preview code { background: #eef; padding: .05em .3em; border-radius: 3px; }
  .markdown-preview blockquote { color: #6b7280; border-left: 3px solid #ddd; margin: .5em 0; padding-left: .8em; }
  .presence-roster { display: flex; gap: .5rem; flex-wrap: wrap; margin: .75rem 0; min-height: 2rem; }
  .presence-roster .peer { display: inline-flex; align-items: center; gap: .4rem; padding: .2rem .6rem; border-radius: 999px; background: #f3f4f6; font-size: .9rem; }
  .presence-roster .peer::before { content: ""; width: .7rem; height: .7rem; border-radius: 50%; background: var(--c); }
  .presence-roster .peer .status { color: #6b7280; font-size: .78rem; }
  .agent-bar { position: sticky; top: 0; z-index: 5; display: flex; gap: .6rem; align-items: center; padding: .4rem .7rem; margin: .5rem 0 .25rem; background: #f5f3ff; border: 1px solid #ddd6fe; border-radius: 8px; font-size: .85rem; color: #4c1d95; }
  .agent-bar .bar-dot { width: .6rem; height: .6rem; border-radius: 50%; background: #c4b5fd; }
  .agent-bar.live .bar-dot { background: #7c3aed; }
  .agent-bar .bar-status { font-weight: 600; }
  .agent-bar .bar-detail { color: #6d28d9; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: .8rem; }
  .agent-bar a { color: #6d28d9; }
  .agent-bar label { font-size: .8rem; display: inline-flex; gap: .3rem; align-items: center; }
  .agent-actions { display: flex; gap: .4rem; flex-wrap: wrap; margin: .25rem 0 .5rem; }
  .agent-actions button { font-size: .8rem; padding: .25rem .6rem; border: 1px solid #ddd6fe; background: #fff; border-radius: 999px; color: #4c1d95; cursor: pointer; }
  .agent-actions button:hover { background: #f5f3ff; }
  .agent-hint { margin: 0 0 .5rem; font-size: .78rem; color: #6b7280; }
  .agent-hint code { background: #f5f3ff; color: #4c1d95; padding: .05em .3em; border-radius: 3px; }
  .invite-agent[disabled] { opacity: .55; cursor: default; }
  .agent-log .thinking.folded { cursor: pointer; }
  .agent-log .thinking.folded::after { content: " (more)"; color: #a78bfa; font-style: normal; }
  .agent-log { list-style: none; margin: .5rem 0 .75rem; padding: .25rem .5rem; font-size: .8rem; color: #374151; height: 9rem; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 8px; background: #fcfcfd; }
  .agent-log li { padding: .15rem 0; border-top: 1px solid #f3f4f6; }
  .agent-log li:first-child { border-top: 0; }
  .agent-log time { color: #9ca3af; font-variant-numeric: tabular-nums; margin-right: .4rem; }
  .agent-log b { font-weight: 600; color: #7c3aed; }
  .agent-log span { color: #6b7280; }
  .agent-log .thinking { margin: .2rem 0 .1rem 1.2rem; padding-left: .6rem; border-left: 2px solid #ddd6fe; color: #6b7280; font-style: italic; white-space: pre-wrap; font-size: .76rem; line-height: 1.4; }
</style>
<script src="/markdown.js?v=<%= File.exist?(Rails.public_path.join("markdown.js")) ? File.mtime(Rails.public_path.join("markdown.js")).to_i : 0 %>" defer></script>
