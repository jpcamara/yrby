<% content_for :title, experimental ? "Pixel Bay · Paint the bay. In Ruby." : "Pixel Bay · shared pixel painting" %>
<% content_for :head do %>
<style>
  :root{--paper:#f6eedb;--ink:#1d2038;--muted:#737167;--line:#d9d1bf;--coral:#c85b50;--green:#447a70}
  *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,textarea{font:inherit}button,a,input,textarea{-webkit-tap-highlight-color:transparent}button{cursor:pointer}button:disabled{cursor:default;opacity:.45}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--coral);outline-offset:4px}button{color:inherit}a{color:inherit}
  .pixel-studio{max-width:1760px;min-height:100svh;margin:0 auto;padding:25px 42px 20px;display:flex;flex-direction:column;gap:26px}.studio-header{display:flex;align-items:center;justify-content:space-between;gap:24px}.studio-brand{display:flex;gap:13px;align-items:center;text-decoration:none}.brand-mark{width:28px;height:28px;display:grid;grid-template-columns:repeat(4,1fr);gap:2px;transform:rotate(-8deg)}.brand-mark i{background:var(--coral)}.brand-mark i:nth-child(3n){background:var(--ink)}.brand-mark i:nth-child(5n){opacity:0}.brand-name{font-size:21px;font-weight:850;letter-spacing:-.8px}.brand-subtitle{font:10px ui-monospace,SFMono-Regular,monospace;letter-spacing:1.5px;text-transform:uppercase;margin-top:3px}.header-right{display:flex;align-items:center;gap:22px}.back-link{font-size:12px;text-decoration:none;color:var(--muted)}.back-link:hover{text-decoration:underline}.outline-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid var(--ink);background:transparent;border-radius:5px;padding:10px 14px;font-size:12px;font-weight:700}.outline-button:hover{background:#ebe2ce}.studio-intro{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;padding:15px 0 4px}.eyebrow{font:10px ui-monospace,SFMono-Regular,monospace;letter-spacing:1.6px;text-transform:uppercase;color:var(--coral);margin:0 0 11px}.studio-intro h1{font-size:clamp(30px,3.1vw,49px);line-height:1.02;letter-spacing:-2px;margin:0;font-weight:850}.studio-intro p{font-size:13px;line-height:1.6;max-width:310px;margin:0;color:#696a6f}.studio-workspace{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:25px;align-items:start;flex:1}.drawing-desk{min-width:0}.canvas-chrome{border:1px solid var(--ink);border-radius:8px;overflow:hidden;background:var(--ink);box-shadow:0 6px 0 #1d203812}.canvas-topbar{height:42px;display:flex;align-items:center;justify-content:space-between;padding:0 15px;background:#eee5d2;border-bottom:1px solid var(--ink);font:10px ui-monospace,SFMono-Regular,monospace;letter-spacing:.6px}.canvas-title{display:flex;gap:9px;align-items:center}.live-dot{width:6px;height:6px;border-radius:50%;background:var(--green);display:inline-block}.live-dot.connecting{background:#bf9a57}.live-dot.offline{background:var(--coral)}.canvas-dimensions{color:var(--muted)}.canvas-wrap{width:100%;aspect-ratio:2/1;position:relative;isolation:isolate;overflow:hidden}.mural-canvas{display:block;width:100%;height:100%;touch-action:none;image-rendering:pixelated;cursor:crosshair;outline-offset:-4px!important}.mural-canvas:focus-visible{outline:3px solid var(--paper)}.cursor-layer{position:absolute;inset:0;pointer-events:none;overflow:hidden}.pixel-cursor{position:absolute;width:1.5625%;height:3.125%;border:2px solid var(--cursor);box-shadow:0 0 0 1px #1d203880;transition:left .07s linear,top .07s linear}.pixel-cursor::after{content:attr(data-name);position:absolute;left:-2px;bottom:calc(100% + 3px);padding:3px 5px;background:var(--cursor);color:#fff;border:1px solid #1d203830;border-radius:3px 3px 3px 0;white-space:nowrap;font:9px ui-monospace,SFMono-Regular,monospace;max-width:120px;overflow:hidden;text-overflow:ellipsis}.pixel-cursor.near-top::after{top:calc(100% + 3px);bottom:auto}.pixel-cursor.near-right::after{left:auto;right:-2px}.pixel-cursor.local{border-color:var(--paper);transition:none;box-shadow:0 0 0 1px var(--ink)}.pixel-cursor.local::after{display:none}.canvas-bottom{display:flex;justify-content:space-between;gap:12px;background:#eee5d2;padding:11px 15px;font:10px ui-monospace,SFMono-Regular,monospace;color:var(--muted);border-top:1px solid var(--ink)}.canvas-bottom strong{color:var(--ink);font-weight:500}.drawing-tools{padding:20px 0 17px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid var(--line)}.palette{display:grid;grid-template-columns:repeat(8,25px);gap:7px}.swatch{width:25px;height:25px;border:1px solid #1d203826;border-radius:3px;position:relative;padding:0}.swatch[aria-pressed="true"]{outline:2px solid var(--ink);outline-offset:3px}.swatch[aria-pressed="true"]::after{content:"";width:5px;height:5px;border-radius:50%;position:absolute;top:9px;left:9px;background:var(--indicator);box-shadow:0 0 0 1px #1d203830}.tool-group{display:flex;gap:5px}.tool-button{display:flex;align-items:center;justify-content:center;gap:6px;min-width:39px;height:37px;border:1px solid var(--line);border-radius:4px;background:transparent;font-size:11px;padding:0 10px}.tool-button:hover{background:#ebe2ce}.tool-button[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}.tool-button svg{width:16px;height:16px}.desk-note{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-top:14px;font-size:11px;color:var(--muted);line-height:1.6}.desk-note p{margin:0}.keyboard-note{white-space:nowrap;font:10px ui-monospace,SFMono-Regular,monospace}kbd{border:1px solid var(--line);border-bottom-width:2px;padding:1px 4px;border-radius:3px;font:inherit}.studio-sidebar{display:flex;flex-direction:column;gap:18px}.artist-card{border:1px solid var(--ink);border-radius:8px;background:#eee5d2;overflow:hidden}.artist-head{display:flex;gap:11px;align-items:center;padding:17px 17px 14px}.ruby-avatar{display:grid;place-items:center;width:40px;height:40px;background:var(--coral);border:1px solid var(--ink);border-radius:5px;color:var(--paper);font-size:24px;box-shadow:2px 2px 0 #1d203824}.artist-head h2{font-size:15px;line-height:1.2;margin:0 0 5px;letter-spacing:-.4px}.artist-role{font:9px ui-monospace,SFMono-Regular,monospace;letter-spacing:.6px;color:var(--muted);text-transform:uppercase}.artist-badge{margin-left:auto;align-self:flex-start;border:1px solid #c6bda9;border-radius:3px;padding:4px 5px;font:8px ui-monospace,SFMono-Regular,monospace;letter-spacing:.4px;color:var(--muted)}.artist-badge.online{color:var(--green);border-color:#447a7070;background:#447a700d}.artist-description{margin:0;padding:0