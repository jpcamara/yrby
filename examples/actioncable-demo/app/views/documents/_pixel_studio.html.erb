ap}.person-description{margin-left:auto;font:9px ui-monospace,SFMono-Regular,monospace;color:var(--muted)}.name-row{display:flex;align-items:center;gap:7px;margin-top:14px;padding-top:12px;border-top:1px solid var(--line);font:9px ui-monospace,SFMono-Regular,monospace;color:var(--muted)}.name-input{background:none;border:none;border-bottom:1px dashed #b6ae9b;min-width:0;width:130px;padding:3px 0;color:var(--ink);font-size:11px;border-radius:0}.studio-footer{display:flex;justify-content:space-between;align-items:center;gap:16px;padding-top:5px;font:9px ui-monospace,SFMono-Regular,monospace;letter-spacing:.5px;color:var(--muted)}.footer-signature{display:flex;align-items:center;gap:7px}.footer-signature i{display:inline-block;width:5px;height:5px;background:var(--coral);box-shadow:7px 0 var(--coral),0 7px var(--coral);margin-right:7px}.sr-only{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);border:1px solid var(--ink);border-radius:6px;background:var(--ink);color:var(--paper);padding:12px 18px;font-size:12px;box-shadow:0 4px 20px #1d203825;z-index:10;max-width:calc(100vw - 40px);text-align:center}.toast[hidden]{display:none}
  @media(min-width:1500px){.pixel-studio{padding-top:35px;gap:35px}.studio-workspace{grid-template-columns:minmax(0,1fr) 310px;gap:32px}.studio-intro{padding-top:25px}.studio-intro p{max-width:360px;font-size:14px}.palette{grid-template-columns:repeat(16,26px);gap:6px}.swatch{width:26px;height:26px}.drawing-tools{padding:25px 0}}
  @media(max-width:1000px){.pixel-studio{padding:22px 24px;gap:22px}.studio-workspace{grid-template-columns:minmax(0,1fr) 255px;gap:18px}.tool-button{padding:0 9px}.tool-text{display:none}.palette{grid-template-columns:repeat(8,22px);gap:6px}.swatch{width:22px;height:22px}.swatch[aria-pressed="true"]::after{top:7px;left:7px}.keyboard-note{display:none}.studio-intro h1{letter-spacing:-1.5px}}
  @media(min-width:761px) and (max-height:850px){
    .pixel-studio{width:min(100%,calc(200svh - 320px));padding:14px 24px 12px;gap:12px}
    .brand-name{font-size:19px}.brand-subtitle{font-size:9px}.outline-button{padding:9px 12px}
    .studio-intro{padding:0;gap:18px}.studio-intro h1{font-size:32px;letter-spacing:-1.3px}.studio-intro .eyebrow{font-size:9px;line-height:1.2;margin-bottom:5px}.studio-intro>p{font-size:11px;line-height:1.5;max-width:260px}
    .studio-workspace{grid-template-columns:minmax(0,1fr) 270px;gap:20px}.canvas-topbar{height:32px;padding:0 11px;font-size:9px}.canvas-bottom{padding:8px 11px;font-size:9px}
    .drawing-tools{padding:9px 0 8px;gap:10px}.palette{grid-template-columns:repeat(8,22px);gap:6px}.swatch{width:22px;height:22px}.swatch[aria-pressed="true"]::after{top:7px;left:7px}.tool-button{width:35px;min-width:35px;height:34px;padding:0}.tool-text{display:none}.desk-note{margin-top:8px;font-size:10px}.keyboard-note{font-size:9px}
    .studio-sidebar{gap:12px;max-height:calc(100svh - 162px);overflow-y:auto;scrollbar-width:thin;padding-bottom:3px}.artist-card{flex-shrink:0}.artist-head{padding:10px 13px}.ruby-avatar{width:36px;height:36px;font-size:22px}.artist-description{padding:0 13px 10px;font-size:11px;line-height:1.55}.artist-controls{padding:10px 13px}.brief-label{margin-bottom:7px}.artist-brief{min-height:54px;height:59px;padding:7px 9px;font-size:11px;line-height:1.5}.artist-submit{margin-top:8px;padding:9px;font-size:11px}.artist-note{padding:10px 13px;min-height:65px;font-size:10px;line-height:1.5}.artist-note-label{margin-bottom:6px}.artist-meta{margin-top:5px}
    .section-label{margin-bottom:8px}.presence-list{flex-direction:row;flex-wrap:wrap;gap:5px 14px}.presence-person{min-height:20px;font-size:10px;gap:6px}.person-description{margin-left:0}.name-row{margin-top:8px;padding-top:8px}.studio-footer{padding-top:0;font-size:8px}
  }
  @media(max-width:760px){.pixel-studio{padding:18px 16px;gap:22px}.brand-subtitle{font-size:8px;letter-spacing:1px}.brand-name{font-size:19px}.header-right{gap:12px}.back-link{display:none}.outline-button{font-size:11px;padding:9px 11px}.studio-intro{display:block;padding-top:8px}.studio-intro h1{font-size:37px}.studio-intro p{margin-top:12px;max-width:430px;font-size:12px}.studio-workspace{grid-template-columns:1fr;gap:24px}.studio-sidebar{display:grid;grid-template-columns:minmax(0,1fr) minmax(130px,.65fr);gap:20px}.artist-head{padding:14px}.artist-description{padding:0 14px 14px}.artist-controls{padding:14px}.artist-note{padding:12px 14px}.studio-footer{align-items:flex-end;line-height:1.8}.canvas-topbar{height:36px;padding:0 11px}.canvas-bottom{padding:9px 11px;font-size:8px}.drawing-tools{padding:17px 0;gap:10px}.palette{grid-template-columns:repeat(8,24px)}.swatch{width:24px;height:24px}.tool-button{min-width:33px;width:33px;padding:0}.tool-group{gap:4px}.desk-note{font-size:10px}.artist-badge{font-size:7px}.section-label{line-height:1.5}.presence-person{font-size:10px}}
  @media(max-width:420px){.drawing-tools{flex-wrap:wrap}.studio-sidebar{grid-template-columns:1fr}.studio-people{padding:0 3px}.presence-list{flex-direction:row;flex-wrap:wrap;gap:9px 17px}.person-description{margin-left:0}.name-row{margin-top:10px}.palette{grid-template-columns:repeat(8,22px);gap:5px}.swatch{width:22px;height:22px}.tool-button{min-width:30px;width:30px}.canvas-dimensions{font-size:8px}.studio-intro h1{font-size:33px}.studio-footer{font-size:8px}}
  @media(prefers-reduced-motion:reduce){.pixel-cursor{transition:none}}
  .experiment-badge{border:1px solid #c85b5070;border-radius:4px;padding:5px 7px;color:var(--coral);font:8px ui-monospace,SFMono-Regular,monospace;letter-spacing:.8px;text-transform:uppercase;white-space:nowrap}
  .pixel-studio-experimental .studio-header{flex-wrap:wrap;gap:14px}.pixel-studio-experimental .header-right{flex-wrap:wrap;gap:10px}.studio-main-link{text-decoration:none}
  .wasm-runtime-card{min-width:0;flex-shrink:0;padding:13px 15px;border:1px solid var(--line);border-radius:6px;background:#eee5d2;font-size:11px;line-height:1.6}
  .wasm-runtime-card .section-label{color:var(--coral);margin-bottom:9px}.wasm-runtime-card p{margin:0}.wasm-runtime-controls{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:9px}.wasm-runtime-controls .outline-button{padding:7px 10px;font-size:10px}
  #wasm-runtime{font:10px ui-monospace,SFMono-Regular,monospace;overflow-wrap:anywhere}#wasm-pending{margin-top:9px;color:var(--muted);font-size:10px}.wasm-runtime-card .wasm-runtime-help{margin-top:10px;color:var(--muted);font-size:10px}.wasm-runtime-source{display:inline-block;margin-top:8px;color:var(--coral);font-size:10px;text-underline-offset:3px}
  #wasm-error{margin-top:12px;border:1px solid var(--coral);border-radius:4px;padding:9px 10px;background:#c85b500b;color:#953f37;font-size:11px;line-height:1.6;overflow-wrap:anywhere}#wasm-error[hidden]{display:none}
  @media(max-width:760px){.pixel-studio-experimental .header-right{gap:8px}.pixel-studio-experimental .studio-brand{gap:10px}.wasm-runtime-card{grid-column:1/-1}.wasm-runtime-controls{gap:12px}.wasm-runtime-card .section-label{margin-bottom:10px}}
</style>
<% end %>

<main class="pixel-studio<%= " pixel-studio-experimental" if experimental %>" id="pixel-studio" data-document-id="<%= @document_id %>:pixels">
  <header class="studio-header">
    <a class="studio-brand" href="<%= document_pixels_path(@document_id) %>" aria-label="Pixel Bay home">
      <span class="brand-mark" aria-hidden="true"><% 16.times do %><i></i><% end %></span>
      <span><span class="brand-name">pixel bay</span><span class="brand-subtitle" style="display:block">A shared pixel canvas</span></span>
      <% if experimental %><span class="experiment-badge">Experimental</span><% end %>
    </a>
    <div class="header-right">
      <% if experimental %>
        <%= link_to "Open main studio ↗", document_pixels_path(@document_id), class: "outline-button studio-main-link", target: "_blank", rel: "noopener" %>
      <% else %>
        <%= link_to "← All examples", document_path(@document_id), class: "back-link" %>
      <% end %>
      <button type="button" class="outline-button" id="share-mural"><span aria-hidden="true">↗</span> Invite a friend</button>
    </div>
  </header>

  <section class="studio-intro" aria-labelledby="mural-heading">
    <div><p class="eyebrow"><%= experimental ? "Same studio. Ruby in your browser." : "San Francisco, one pixel at a time." %></p><h1 id="mural-heading"><%= experimental ? "Paint the bay. In Ruby." : "Paint the bay together." %></h1></div>
    <% if experimental %>
      <p>The full studio, running in Ruby in this browser.<br>Paint with friends and your AI co-artist.</p>
    <% else %>
      <p>Pick a color and draw with friends.<br>Invite Ruby to add AI-painted details.</p>
    <% end %>
  </section>

  <div class="studio-workspace">
    <section class="drawing-desk" aria-label="Shared pixel mural">
      <div class="canvas-chrome">
        <div class="canvas-topbar"><span class="canvas-title"><span class="live-dot connecting" id="connection-dot" aria-hidden="true"></span><span id="connection-status" role="status"><%= experimental ? "Loading Ruby…" : "Connecting…" %></span></span><span class="canvas-dimensions">64 × 32 pixels · 16 colors</span></div>
        <div class="canvas-wrap" id="canvas-wrap">
          <canvas id="mural-canvas" class="mural-canvas" width="1024" height="512" tabindex="0" aria-label="Shared pixel mural. Use arrow keys to move, Space to paint, B for brush, E for eraser, and Control or Command Z to undo your last stroke." aria-describedby="canvas-help"></canvas>
          <div class="cursor-layer" id="cursor-layer" aria-hidden="true"></div>
        </div>
        <div class="canvas-bottom"><span>OUR SHARED SAN FRANCISCO</span><span id="cell-status"><strong>Choose a color</strong> and draw</span></div>
      </div>

      <div class="drawing-tools">
        <div class="palette" id="palette" role="group" aria-label="Paint colors"></div>
        <div class="tool-group" role="group" aria-label="Drawing tools">
          <button type="button" class="tool-button" id="brush-tool" aria-label="Brush (B)" aria-pressed="true" title="Brush (B)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m14 5 5 5M4 20l5-1L21 7l-5-5L4 14zM4 14l5 5"/></svg><span class="tool-text">Brush</span></button>
          <button type="button" class="tool-button" id="eraser-tool" aria-label="Eraser: restore original scene (E)" aria-pressed="false" title="Restore original scene (E)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m14 3 7 7-10 10H7l-5-5zM8 9l7 7M10 20h12"/></svg><span class="tool-text">Erase</span></button>
          <button type="button" class="tool-button" id="undo-stroke" aria-label="Undo your last stroke (Command or Control Z)" title="Undo your last stroke" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 5 3 10l5 5M3 10h11a6 6 0 0 1 0 12" transform="translate(0 -2)"/></svg><span class="tool-text">Undo</span></button>
          <button type="button" class="tool-button" id="grid-tool" aria-label="Show pixel grid" aria-pressed="false" title="Show pixel grid"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="1"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg></button>
        </div>
      </div>
      <div class="desk-note"><p id="canvas-help">Your strokes stay on top of Ruby’s.</p><span class="keyboard-note"><kbd>B</kbd> brush &nbsp; <kbd>E</kbd> erase &nbsp; <kbd>⌘ Z</kbd> undo</span></div>
    </section>

    <aside class="studio-sidebar" aria-label="Collaborators">
      <section class="artist-card" aria-labelledby="artist-name">
        <div class="artist-head"><div class="ruby-avatar" aria-hidden="true">✦</div><div><h2 id="artist-name">Meet Ruby.</h2><div class="artist-role">Your AI co-artist</div></div><span class="artist-badge" id="artist-badge">OFFLINE</span></div>
        <p class="artist-description">Ruby reads the canvas and adds new details alongside your strokes.</p>
        <div class="artist-controls">
          <label class="brief-label" for="artist-brief">Give Ruby a direction <span>Shared</span></label>
          <textarea class="artist-brief" id="artist-brief" maxlength="240" rows="3" placeholder="Add sailboats, bright rooftops, and a few clouds."></textarea>
          <form id="invite-artist" action="<%= document_pixels_artist_path(@document_id) %>" method="post"><button class="artist-submit" id="invite-artist-button" type="submit"<%= " disabled" if experimental %>>✦ Invite Ruby to paint</button></form>
          <button class="artist-submit artist-remove" id="remove-artist" type="button" hidden>Let Ruby take a break</button>
        </div>
        <div class="artist-note" id="artist-note" role="status" aria-live="polite"><div class="artist-note-label"><span id="artist-phase-dot" class="live-dot offline" aria-hidden="true"></span><span id="artist-phase">Ready when you are</span></div><p id="artist-commentary">Invite Ruby to add details to the canvas.</p><div class="artist-meta" id="artist-meta" hidden></div></div>
      </section>

      <section class="studio-people" aria-labelledby="people-heading"><h2 class="section-label" id="people-heading">Here in the studio <span id="presence-count">Just you</span></h2><div class="presence-list" id="presence-list"></div><label class="name-row" for="your-name">YOU ARE <input class="name-input" id="your-name" aria-label="Your display name" maxlength="24" autocomplete="off" spellcheck="false"></label></section>
      <% if experimental %>
        <section class="wasm-runtime-card" aria-labelledby="wasm-runtime-heading">
          <h2 class="section-label" id="wasm-runtime-heading">Experimental Ruby client</h2>
          <div class="wasm-runtime-controls">
            <p id="wasm-runtime" role="status">Loading Ruby…</p>
            <button class="outline-button" id="wasm-toggle-connection" type="button" disabled>Disconnect</button>
          </div>
          <p id="wasm-pending" role="status">Loading the browser client…</p>
          <p class="wasm-runtime-help">Try it: disconnect, paint in both studios, then reconnect to merge your marks.</p>
          <a class="wasm-runtime-source" href="/ruby-wasm/pixel_peer.rb" target="_blank" rel="noopener">Read the Ruby source ↗</a>
          <div id="wasm-error" role="alert" hidden></div>
        </section>
      <% end %>
    </aside>
  </div>

  <footer class="studio-footer"><span class="footer-signature"><i aria-hidden="true"></i> One canvas. Everyone’s marks.</span><span><% if experimental %>Ruby WASM experiment · yrby<% else %><%= link_to "Ruby/WASM experiment ↗", document_pixels_wasm_path(@document_id), target: "_blank", rel: "noopener" %> · Built with yrby + Ruby<% end %></span></footer>
  <div class="toast" id="studio-toast" role="status" hidden></div>
</main>
